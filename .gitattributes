# Normalize line endings for text, keep binaries and scripts untouched.
* text=auto eol=lf

*.sh   text eol=lf
*.py   text eol=lf
*.md   text eol=lf
*.toml text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf

*.safetensors binary
*.onnx        binary
*.npy         binary
*.png         binary
*.jpg         binary

# Keep lockfiles out of diffs and language stats.
scripts/uv.lock linguist-generated=true -diff
LICENSE         linguist-vendored=true
